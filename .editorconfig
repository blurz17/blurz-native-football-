# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

# C++ files
[*.{cpp,hpp,c,h}]
indent_style = space
indent_size = 4

# Java files
[*.java]
indent_style = space
indent_size = 4

# Gradle/Groovy files
[*.gradle]
indent_style = space
indent_size = 4

# CMake files
[CMakeLists.txt]
indent_style = space
indent_size = 4
