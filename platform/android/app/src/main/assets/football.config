# gameplay football config
# Uncapped graphics frametime for 60-120 FPS high refresh rate rendering
graphics3d_frametime_ms=0
physics_frametime_ms=10
# graphics_resolution_x=1280
# graphics_resolution_y=720
graphics_fullscreen=1
# Re-enabled post processing and shadows for amazing graphics!
graphics3d_postprocess=true
graphics3d_shadows=true
